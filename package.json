{
  "name": "free-ai-commit-message",
  "displayName": "Free AI Commit Message",
  "description": "Generate Conventional Commit messages from staged git changes. Bring-your-own-key: works with Groq, OpenRouter, DeepSeek, Ollama, OpenAI, Gemini and Claude. Free to use.",
  "version": "0.1.0",
  "engines": {
    "node": ">=18",
    "vscode": "^1.77.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "OpenAI",
    "ChatGPT",
    "Gemini",
    "Claude",
    "Anthropic",
    "Groq",
    "Ollama",
    "OpenRouter",
    "DeepSeek",
    "GitEmoji",
    "Git Commit",
    "Conventional Commits",
    "Commitizen",
    "Commit Message",
    "Commit Message Generator",
    "AI Commit",
    "Auto Commit"
  ],
  "publisher": "ChristianGennari",
  "repository": "",
  "activationEvents": [
    "onCommand:aiCommitMessage.generateMessage",
    "onCommand:aiCommitMessage.selectProfile",
    "onCommand:aiCommitMessage.setApiKey",
    "onCommand:aiCommitMessage.showAvailableModels"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiCommitMessage.generateMessage",
        "icon": "$(git-commit)",
        "title": "Generate Commit Message"
      },
      {
        "command": "aiCommitMessage.selectProfile",
        "title": "Select Provider Profile"
      },
      {
        "command": "aiCommitMessage.setApiKey",
        "title": "Set API Key for Active Profile"
      },
      {
        "command": "aiCommitMessage.showAvailableModels",
        "title": "Show Available Models"
      }
    ],
    "configuration": {
      "title": "Free AI Commit Message",
      "properties": {
        "aiCommitMessage.activeProfile": {
          "type": "string",
          "default": "openai",
          "description": "Name of the active provider profile (see aiCommitMessage.profiles)."
        },
        "aiCommitMessage.profiles": {
          "type": "object",
          "default": {},
          "description": "Provider profiles. Each entry: { kind: 'openai-compatible'|'gemini'|'claude', baseUrl?, model, temperature? }. API keys are stored separately in VS Code secret storage."
        },
        "aiCommitMessage.language": {
          "type": "string",
          "default": "English",
          "enum": [
            "English",
            "Swedish",
            "Simplified Chinese",
            "Traditional Chinese",
            "Japanese",
            "Korean",
            "Czech",
            "German",
            "French",
            "Italian",
            "Dutch",
            "Portuguese",
            "Vietnamese",
            "Spanish",
            "Russian",
            "Bahasa",
            "Polish",
            "Turkish",
            "Thai"
          ],
          "description": "Commit message language."
        },
        "aiCommitMessage.enableGitmoji": {
          "type": "boolean",
          "default": false,
          "description": "Prefix commit types with gitmoji emoji. Defaults to plain Conventional Commits when off."
        },
        "aiCommitMessage.customSystemPrompt": {
          "type": "string",
          "default": "",
          "description": "Optional custom system prompt. Replaces the generated default prompt entirely. Use '\\n' for newlines."
        },
        "aiCommitMessage.maxDiffCharacters": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Hard cap on diff characters sent to the provider."
        },
        "aiCommitMessage.diffOverflowStrategy": {
          "type": "string",
          "default": "truncate",
          "enum": [
            "truncate",
            "fail"
          ],
          "description": "'truncate' keeps head+tail of the diff with a warning; 'fail' aborts with an error."
        },
        "aiCommitMessage.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for all providers."
        }
      }
    },
    "menus": {
      "scm/title": [
        {
          "command": "aiCommitMessage.generateMessage",
          "group": "navigation"
        }
      ]
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "webpack --mode production --devtool hidden-source-map",
    "compile": "webpack",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "publish": "vsce publish --no-dependencies",
    "test": "vitest run --exclude 'test/ollama-smoke.test.ts'",
    "test:smoke": "vitest run test/ollama-smoke.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run build",
    "watch": "webpack --watch"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^9.0.0",
    "@types/node": "25.x",
    "@types/vscode": "^1.77.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.3.0",
    "glob": "^13.0.6",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@google/generative-ai": "^0.24.1",
    "fs-extra": "^11.3.4",
    "openai": "^6.36.0",
    "simple-git": "^3.36.0"
  },
  "license": "MIT"
}
