{
  "name": "free-ai-commit-message",
  "displayName": "Free AI Commit Message",
  "description": "Generate clean, conventional Git commit messages out of the box with zero setup, or connect your own free BYOK providers (Gemini, Groq, OpenRouter) and offline local Ollama.",
  "version": "0.1.17",
  "icon": "icon.png",
  "engines": {
    "node": ">=18",
    "vscode": "^1.77.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "OpenAI",
    "ChatGPT",
    "Gemini",
    "Claude",
    "Anthropic",
    "Groq",
    "Ollama",
    "OpenRouter",
    "DeepSeek",
    "GitEmoji",
    "Git Commit",
    "Conventional Commits",
    "Commitizen",
    "Commit Message",
    "Commit Message Generator",
    "AI Commit",
    "Auto Commit"
  ],
  "publisher": "christiangennari",
  "repository": {
    "type": "git",
    "url": "https://github.com/Christian-Gennari/vscode-extension-free-ai-commit-message.git"
  },
  "activationEvents": [
    "onCommand:aiCommitMessage.generateCommitMsg",
    "onCommand:aiCommitMessage.selectProfile",
    "onCommand:aiCommitMessage.setApiKey",
    "onCommand:aiCommitMessage.deleteApiKey",
    "onCommand:aiCommitMessage.showAvailableModels"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiCommitMessage.generateCommitMsg",
        "title": "Generate AI Commit Message",
        "category": "Free AI Commit",
        "icon": "$(sparkle)"
      },
      {
        "command": "aiCommitMessage.setApiKey",
        "title": "Set API Key for Active Profile",
        "category": "Free AI Commit"
      },
      {
        "command": "aiCommitMessage.deleteApiKey",
        "title": "Delete API Key for Active Profile",
        "category": "Free AI Commit"
      },
      {
        "command": "aiCommitMessage.selectProfile",
        "title": "Switch Active AI Profile",
        "category": "Free AI Commit"
      },
      {
        "command": "aiCommitMessage.showAvailableModels",
        "title": "Select Model for Active Profile",
        "category": "Free AI Commit"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aiCommitMessage.generateCommitMsg",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Free AI Commit Message",
      "properties": {
        "aiCommitMessage.activeProfile": {
          "type": "string",
          "default": "free",
          "enum": [
            "free",
            "gemini",
            "groq",
            "github",
            "openrouter",
            "ollama",
            "deepseek",
            "openai",
            "claude"
          ],
          "enumDescriptions": [
            "Free (No Setup Required) — Instant quick-start with zero API key configuration",
            "Google AI Studio (Gemini 3.5 Flash Lite — Free tier: 30 RPM, 1,500 req/day)",
            "Groq Cloud (openai/gpt-oss-120b — Free tier on Groq LPU: 30 RPM, 14,400 req/day)",
            "GitHub Models (GPT-4o mini — Free tier with GitHub PAT: 15 RPM, 150 req/day)",
            "OpenRouter (cohere/north-mini-code:free — Free dedicated code model)",
            "Ollama (Qwen 2.5 Coder 3B — 100% offline, local, free)",
            "DeepSeek (DeepSeek-V3 / deepseek-chat — BYOK)",
            "OpenAI (GPT-4o mini direct API — BYOK)",
            "Claude (Claude 3.5 Haiku — BYOK)"
          ],
          "description": "Active AI provider profile. Note: API keys are NOT stored here in plain text. To set/change your key for the active profile, press 'Ctrl+Shift+P' and run 'Free AI Commit: Set API Key for Active Profile' (keys are saved separately per provider in VS Code's encrypted keychain)."
        },
        "aiCommitMessage.profiles": {
          "type": "object",
          "default": {},
          "markdownDescription": "Custom provider overrides or additional endpoints (optional).\n\n**Example in `settings.json`:**\n```json\n\"aiCommitMessage.profiles\": {\n  \"my-custom-proxy\": {\n    \"kind\": \"openai-compatible\",\n    \"baseUrl\": \"http://localhost:1234/v1\",\n    \"model\": \"local-model-name\",\n    \"temperature\": 0.7\n  }\n}\n```\nPre-configured built-in presets (`gemini`, `groq`, `github`, `openrouter`, `ollama`, `deepseek`, `openai`, `claude`) work out of the box.",
          "defaultSnippets": [
            {
              "label": "Custom OpenAI-compatible profile",
              "description": "Add a custom OpenAI-compatible endpoint (e.g. LM Studio, vLLM, private proxy)",
              "body": {
                "${1:custom-profile}": {
                  "kind": "openai-compatible",
                  "baseUrl": "${2:http://localhost:1234/v1}",
                  "model": "${3:model-name}",
                  "temperature": 0.7
                }
              }
            }
          ],
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "openai-compatible",
                  "gemini",
                  "claude"
                ],
                "description": "Provider protocol ('openai-compatible', 'gemini', or 'claude')."
              },
              "baseUrl": {
                "type": "string",
                "description": "API Base URL (required for openai-compatible custom endpoints, e.g. 'http://localhost:1234/v1')."
              },
              "model": {
                "type": "string",
                "description": "Model identifier to invoke (e.g. 'llama-3.3-70b-versatile', 'gpt-4o', 'qwen2.5-coder:7b')."
              },
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2,
                "description": "Sampling temperature override (0.0 to 2.0)."
              }
            }
          }
        },
        "aiCommitMessage.language": {
          "type": "string",
          "default": "English",
          "enum": [
            "English",
            "Swedish",
            "Simplified Chinese",
            "Traditional Chinese",
            "Japanese",
            "Korean",
            "Czech",
            "German",
            "French",
            "Italian",
            "Dutch",
            "Portuguese",
            "Vietnamese",
            "Spanish",
            "Russian",
            "Bahasa",
            "Polish",
            "Turkish",
            "Thai"
          ],
          "description": "Commit message language."
        },
        "aiCommitMessage.enableGitmoji": {
          "type": "boolean",
          "default": false,
          "description": "Prefix commit types with gitmoji emoji. Defaults to plain Conventional Commits when off."
        },
        "aiCommitMessage.customSystemPrompt": {
          "type": "string",
          "default": "",
          "description": "Optional custom system prompt. Replaces the generated default prompt entirely. Use '\\n' for newlines."
        },
        "aiCommitMessage.maxDiffCharacters": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Hard cap on diff characters sent to the provider."
        },
        "aiCommitMessage.diffOverflowStrategy": {
          "type": "string",
          "default": "truncate",
          "enum": [
            "truncate",
            "fail"
          ],
          "description": "'truncate' keeps head+tail of the diff with a warning; 'fail' aborts with an error."
        },
        "aiCommitMessage.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for all providers."
        },
        "aiCommitMessage.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "maximum": 600000,
          "description": "Maximum time in milliseconds to wait for an AI provider response."
        }
      }
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "webpack --mode production --devtool hidden-source-map",
    "check": "npm run test && npm run build && npm run package",
    "compile": "webpack",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "publish": "vsce publish --no-dependencies",
    "test": "vitest run --exclude 'test/ollama-smoke.test.ts'",
    "test:smoke": "vitest run test/ollama-smoke.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run build",
    "watch": "webpack --watch"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^9.0.0",
    "@types/node": "25.x",
    "@types/vscode": "^1.77.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.3.0",
    "glob": "^13.0.6",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@google/generative-ai": "^0.24.1",
    "fs-extra": "^11.3.4",
    "openai": "^6.36.0",
    "simple-git": "^3.36.0"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Christian-Gennari/vscode-extension-free-ai-commit-message/issues"
  },
  "homepage": "https://github.com/Christian-Gennari/vscode-extension-free-ai-commit-message#readme"
}
